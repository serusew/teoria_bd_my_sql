USE CollegeDB;
GO

IF OBJECT_ID('college.student_changes', 'U') IS NOT NULL
    DROP TABLE college.student_changes;
GO

CREATE TABLE college.student_changes
(
    id                INT IDENTITY(1,1) PRIMARY KEY,
    student_id        INT           NOT NULL,
    old_average_grade DECIMAL(4,2)  NULL,
    new_average_grade DECIMAL(4,2)  NULL,
    change_date       DATETIME2     NOT NULL
);
GO

IF OBJECT_ID('college.trg_Students_Changes', 'TR') IS NOT NULL
    DROP TRIGGER college.trg_Students_Changes;
GO

CREATE TRIGGER college.trg_Students_Changes
ON college.students
AFTER UPDATE
AS
BEGIN
    SET NOCOUNT ON;

    INSERT INTO college.student_changes
    (
        student_id,
        old_average_grade,
        new_average_grade,
        change_date
    )
    SELECT
        d.id,
        d.average_grade,
        i.average_grade,
        SYSDATETIME()
    FROM deleted AS d
    JOIN inserted AS i ON i.id = d.id
    WHERE d.average_grade <> i.average_grade;
END;
GO

UPDATE college.students
SET average_grade = average_grade + 0.1
WHERE group_id = 1;
GO

SELECT * FROM college.student_changes;
GO

IF OBJECT_ID('college.trg_Students_CheckGrade', 'TR') IS NOT NULL
    DROP TRIGGER college.trg_Students_CheckGrade;
GO

CREATE TRIGGER college.trg_Students_CheckGrade
ON college.students
AFTER INSERT, UPDATE
AS
BEGIN
    SET NOCOUNT ON;

    IF EXISTS
    (
        SELECT 1
        FROM inserted
        WHERE average_grade > 5
    )
    BEGIN
        THROW 50001, N'Средний балл не может быть больше 5', 1;
    END;
END;
GO

UPDATE college.students
SET average_grade = 5.5
WHERE id = 1;
GO
