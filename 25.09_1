GO

IF OBJECT_ID('college.GetScholarship', 'FN') IS NOT NULL
    DROP FUNCTION college.GetScholarship;
GO

CREATE FUNCTION college.GetScholarship
(
    @average_grade DECIMAL(4,2)
)
RETURNS INT
AS
BEGIN
    DECLARE @scholarship INT;

    IF @average_grade >= 4.80
        SET @scholarship = 5000;
    ELSE IF @average_grade >= 4.50
        SET @scholarship = 4000;
    ELSE IF @average_grade >= 4.00
        SET @scholarship = 3000;
    ELSE
        SET @scholarship = 0;

    RETURN @scholarship;
END;
GO

SELECT college.GetScholarship(4.90) AS scholarship_4_90;
SELECT college.GetScholarship(4.60) AS scholarship_4_60;
SELECT college.GetScholarship(4.20) AS scholarship_4_20;
SELECT college.GetScholarship(3.50) AS scholarship_3_50;
GO

SELECT
    s.name                                  AS student_name,
    s.average_grade,
    college.GetScholarship(s.average_grade) AS scholarship
FROM college.students AS s
ORDER BY s.average_grade DESC;
GO

IF OBJECT_ID('college.GetStudentsByMinGrade', 'IF') IS NOT NULL
    DROP FUNCTION college.GetStudentsByMinGrade;
GO

CREATE FUNCTION college.GetStudentsByMinGrade
(
    @min_grade DECIMAL(4,2)
)
RETURNS TABLE
AS
RETURN
(
    SELECT
        s.id,
        s.name,
        s.age,
        s.average_grade,
        s.group_id,
        g.name AS group_name
    FROM college.students AS s
    JOIN college.groups   AS g ON g.id = s.group_id
    WHERE s.average_grade >= @min_grade
);
GO

SELECT *
FROM college.GetStudentsByMinGrade(4.50)
ORDER BY average_grade DESC;
GO

SELECT
    s.name,
    s.average_grade
FROM college.GetStudentsByMinGrade(4.00) AS s
ORDER BY s.average_grade DESC;
GO

SELECT
    s.name                                  AS student_name,
    s.group_name,
    s.average_grade,
    college.GetScholarship(s.average_grade) AS scholarship
FROM college.GetStudentsByMinGrade(4.00) AS s
ORDER BY s.average_grade DESC;
GO
