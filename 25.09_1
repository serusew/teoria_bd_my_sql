IF DB_ID('CollegeDB') IS NULL
BEGIN
    CREATE DATABASE CollegeDB;
END;
GO

USE CollegeDB;
GO

IF NOT EXISTS (SELECT 1 FROM sys.schemas WHERE name = 'college')
BEGIN
    EXEC('CREATE SCHEMA college');
END;
GO

IF OBJECT_ID('college.students', 'U') IS NOT NULL
    DROP TABLE college.students;
GO

IF OBJECT_ID('college.groups', 'U') IS NOT NULL
    DROP TABLE college.groups;
GO

CREATE TABLE college.groups
(
    id   INT           NOT NULL PRIMARY KEY,
    name NVARCHAR(50)  NOT NULL
);
GO

CREATE TABLE college.students
(
    id            INT            NOT NULL PRIMARY KEY,
    name          NVARCHAR(100)  NOT NULL,
    age           INT            NOT NULL,
    average_grade DECIMAL(4,2)   NOT NULL,
    group_id      INT            NOT NULL,
    CONSTRAINT FK_students_groups
        FOREIGN KEY (group_id) REFERENCES college.groups(id)
);
GO

INSERT INTO college.groups (id, name) VALUES
    (1, N'ИС-101'),
    (2, N'ИС-102'),
    (3, N'ПИ-201');
GO

