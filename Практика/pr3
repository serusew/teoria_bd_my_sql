WITH LocationTree AS
(
    -- Начальная локация — Королевство
    SELECT
        id,
        name,
        parent_id,
        location_type,
        difficulty,
        reward,
        0 AS level
    FROM game.locations
    WHERE name = N'Королевство'

    UNION ALL

    -- Рекурсивный обход дочерних локаций
    SELECT
        c.id,
        c.name,
        c.parent_id,
        c.location_type,
        c.difficulty,
        c.reward,
        p.level + 1
    FROM game.locations AS c
    INNER JOIN LocationTree AS p ON c.parent_id = p.id
)
SELECT
    name                             AS [Локация],
    location_type                    AS [Тип],
    level                            AS [Уровень],
    difficulty                       AS [Сложность],
    reward                           AS [Награда],
    REPLICATE(N'    ', level) + name AS [Дерево],
    CAST(difficulty AS NVARCHAR(10)) + N' | ' +
    CAST(reward     AS NVARCHAR(10)) AS [Сложность | Награда]
FROM LocationTree
ORDER BY level, name
OPTION (MAXRECURSION 100);
GO


WITH LocationTree AS
(
    SELECT
        id, name, parent_id, location_type,
        difficulty, reward, 0 AS level
    FROM game.locations
    WHERE name = N'Королевство'

    UNION ALL

    SELECT
        c.id, c.name, c.parent_id, c.location_type,
        c.difficulty, c.reward, p.level + 1
    FROM game.locations AS c
    INNER JOIN LocationTree AS p ON c.parent_id = p.id
)
SELECT
    name       AS [Локация],
    difficulty AS [Сложность],
    CASE
        WHEN difficulty BETWEEN 1 AND 3 THEN N'Безопасная'
        WHEN difficulty BETWEEN 4 AND 6 THEN N'Опасная'
        WHEN difficulty BETWEEN 7 AND 9 THEN N'Очень опасная'
        WHEN difficulty = 10            THEN N'Босс'
        ELSE N'Неизвестно'
    END        AS [Статус]
FROM LocationTree
ORDER BY difficulty, name
OPTION (MAXRECURSION 100);
GO


WITH Subtree AS
(
    SELECT
        id          AS root_id,
        id          AS node_id,
        parent_id,
        reward
    FROM game.locations

    UNION ALL

    SELECT
        s.root_id,
        c.id,
        c.parent_id,
        c.reward
    FROM game.locations AS c
    INNER JOIN Subtree AS s ON c.parent_id = s.node_id
)
SELECT
    l.name        AS [Локация],
    SUM(s.reward) AS [Суммарная награда потомков]
FROM Subtree AS s
INNER JOIN game.locations AS l ON l.id = s.root_id
WHERE s.node_id <> s.root_id          
GROUP BY l.id, l.name
HAVING SUM(s.reward) > 0
ORDER BY [Суммарная награда потомков] DESC;
GO
