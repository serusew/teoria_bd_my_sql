-- блок 1

WITH DangerousLocations AS
(
    SELECT
        id,
        name,
        difficulty,
        reward
    FROM game.locations
    WHERE difficulty >= 5
)
SELECT *
FROM DangerousLocations;
GO

-- блок 2

WITH LocationStatistics AS
(
    SELECT
        p.id,
        p.name,
        COUNT(c.id)        AS children_count,
        AVG(c.difficulty)  AS avg_difficulty,
        MAX(c.reward)      AS max_reward
    FROM game.locations AS p
    LEFT JOIN game.locations AS c ON c.parent_id = p.id
    GROUP BY p.id, p.name
)
SELECT
    name           AS [Локация],
    children_count AS [Количество дочерних],
    avg_difficulty AS [Средняя сложность],
    max_reward     AS [Максимальная награда]
FROM LocationStatistics
WHERE children_count > 0
ORDER BY name;
GO

-- блок 3

WITH RegionDanger AS
(
    SELECT
        r.id,
        r.name            AS region_name,
        r.difficulty      AS region_difficulty,
        MAX(c.difficulty) AS max_child_difficulty
    FROM game.locations AS r
    INNER JOIN game.locations AS c ON c.parent_id = r.id
    WHERE r.location_type = N'Регион'
    GROUP BY r.id, r.name, r.difficulty
)
SELECT
    region_name          AS [Регион],
    region_difficulty    AS [Сложность региона],
    max_child_difficulty AS [Макс. сложность дочерних]
FROM RegionDanger
WHERE max_child_difficulty >= 7;
GO

-- блок 4

WITH LocationTree AS
(
    -- Начальная локация
    SELECT
        id,
        name,
        parent_id,
        location_type,
        difficulty,
        reward
    FROM game.locations
    WHERE name = N'Северные земли'

    UNION ALL

    -- Поиск дочерних локаций
    SELECT
        c.id,
        c.name,
        c.parent_id,
        c.location_type,
        c.difficulty,
        c.reward
    FROM game.locations AS c
    INNER JOIN LocationTree AS p ON c.parent_id = p.id
)
SELECT *
FROM LocationTree;
GO

-- блок 5

WITH LocationTree AS
(
    -- Начальная локация
    SELECT
        id,
        name,
        parent_id,
        location_type,
        difficulty,
        reward,
        0 AS level
    FROM game.locations
    WHERE name = N'Северные земли'

    UNION ALL

    -- Поиск дочерних локаций
    SELECT
        c.id,
        c.name,
        c.parent_id,
        c.location_type,
        c.difficulty,
        c.reward,
        p.level + 1
    FROM game.locations AS c
    INNER JOIN LocationTree AS p ON c.parent_id = p.id
)
SELECT
    name  AS [Локация],
    level AS [Уровень]
FROM LocationTree
ORDER BY level, name;
GO

