USE CollegeDB;
GO

IF OBJECT_ID('college.groups', 'U') IS NULL
BEGIN
    CREATE TABLE college.groups (
        id   INT IDENTITY(1,1) PRIMARY KEY,
        name NVARCHAR(50) NOT NULL
    );
END
GO

IF OBJECT_ID('college.students', 'U') IS NULL
BEGIN
    CREATE TABLE college.students (
        id            INT IDENTITY(1,1) PRIMARY KEY,
        name          NVARCHAR(100) NOT NULL,
        age           INT NOT NULL,
        average_grade DECIMAL(3,2) NOT NULL,
        group_id      INT NULL
    );
END
GO

IF NOT EXISTS (
    SELECT 1 FROM sys.columns
    WHERE object_id = OBJECT_ID('college.students') AND name = 'group_id'
)
BEGIN
    ALTER TABLE college.students ADD group_id INT NULL;
END
GO

