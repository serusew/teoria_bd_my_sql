IF NOT EXISTS (SELECT 1 FROM sys.schemas WHERE name = 'college')
    EXEC('CREATE SCHEMA college');
GO

--1 

IF OBJECT_ID('college.Groups', 'U') IS NULL
CREATE TABLE college.Groups (
    group_id   INT PRIMARY KEY,
    group_name NVARCHAR(50) NOT NULL
);
GO

IF OBJECT_ID('college.Students', 'U') IS NULL
CREATE TABLE college.Students (
    student_id INT PRIMARY KEY,
    first_name NVARCHAR(50) NOT NULL,
    last_name  NVARCHAR(50) NOT NULL
);
GO

IF OBJECT_ID('college.StudentGroups', 'U') IS NULL
CREATE TABLE college.StudentGroups (
    student_id INT NOT NULL,
    group_id   INT NOT NULL,
    CONSTRAINT PK_StudentGroups PRIMARY KEY (student_id, group_id),
    CONSTRAINT FK_SG_Student FOREIGN KEY (student_id) REFERENCES college.Students(student_id),
    CONSTRAINT FK_SG_Group   FOREIGN KEY (group_id)   REFERENCES college.Groups(group_id)
);
GO

IF OBJECT_ID('college.Grades', 'U') IS NULL
CREATE TABLE college.Grades (
    grade_id   INT IDENTITY PRIMARY KEY,
    student_id INT NOT NULL,
    grade      INT NOT NULL CHECK (grade BETWEEN 1 AND 5),
    CONSTRAINT FK_Grades_Student FOREIGN KEY (student_id)
        REFERENCES college.Students(student_id)
);
GO

