GO

-- 3 

CREATE OR ALTER PROCEDURE college.GetStudentStatistics
    @student_id INT
AS
BEGIN
    SET NOCOUNT ON;

    IF NOT EXISTS (SELECT 1 FROM college.Students WHERE student_id = @student_id)
    BEGIN
        THROW 50001, N'Студент с указанным ID не найден.', 1;
    END;

    SELECT
        s.first_name + N' ' + s.last_name   AS student_name,
        g.group_name                        AS group_name,
        COUNT(gr.grade)                     AS grades_count,
        AVG(CAST(gr.grade AS DECIMAL(5,2))) AS avg_grade,
        MIN(gr.grade)                       AS min_grade,
        MAX(gr.grade)                       AS max_grade
    FROM college.Students s
    LEFT JOIN college.StudentGroups sg ON sg.student_id = s.student_id
    LEFT JOIN college.Groups g         ON g.group_id    = sg.group_id
    LEFT JOIN college.Grades gr        ON gr.student_id = s.student_id
    WHERE s.student_id = @student_id
    GROUP BY s.first_name, s.last_name, g.group_name;
END;
GO

-- 4 Проверка 

EXEC college.GetStudentStatistics @student_id = 1;
BEGIN TRY
    EXEC college.GetStudentStatistics @student_id = 999;
END TRY
BEGIN CATCH
    SELECT
        ERROR_NUMBER()    AS error_number,
        ERROR_MESSAGE()   AS error_message,
        ERROR_SEVERITY()  AS severity,
        ERROR_STATE()     AS state;
END CATCH;
GO
